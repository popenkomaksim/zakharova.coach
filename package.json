{
  "name": "zakharova.coach",
  "version": "0.1.0",
  "homepage": "https://zakharova.coach/",
  "private": true,
  "dependencies": {
    "@ericz1803/react-google-calendar": "^4.3.2",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "antd": "^6.6.2",
    "axios": "^1.6.5",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-countup": "^6.5.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "react-scripts": "^5.0.1",
    "rebass": "^4.0.7",
    "styled-components": "^6.5.3",
    "web-vitals": "^6.2.1"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build && cp build/index.html build/404.html",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.7.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react-perf": "^3.3.1",
    "eslint-plugin-styled-components-varname": "^1.0.1",
    "gh-pages": "^6.3.0"
  },
  "overrides": {
    "@babel/core": "^7.26.0"
  },
  "jest": {
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!axios[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^@rc-component/([^/]+)/(?!assets/|lib/|es/)(.+)$": "@rc-component/$1/lib/$2",
      "^react-router/dom$": "react-router/dist/development/dom-export.js"
    }
  }
}
